{
  "name": "G2 Six-Mon Team",
  "customAbilities": [
    {
      "id": "mega-sol-leaf-guard",
      "entry": "{name: 'Mega Sol + Leaf Guard', shortDesc: 'This Pokemon uses moves as if Sunny Day were active and cannot be statused.', onChargeMove(pokemon, target, move) { if (move.id === 'solarbeam' || move.id === 'solarblade') return false; }, onModifyTypePriority: -2, onModifyType(move) { if (move.id === 'weatherball') move.type = 'Fire'; }, onModifyMove(move) { if (move.id === 'weatherball') move.basePower = 100; if (move.id === 'synthesis' || move.id === 'moonlight' || move.id === 'morningsun') { move.onHit = function(pokemon) { const success = !!this.heal(this.modify(pokemon.maxhp, 0.667)); if (!success) { this.add('-fail', pokemon, 'heal'); return this.NOT_FAIL; } return success; }; } }, onBasePowerPriority: 21, onBasePower(basePower, pokemon, target, move) { if ((move.id === 'solarbeam' || move.id === 'solarblade') && ['raindance', 'primordialsea', 'sandstorm', 'hail', 'snowscape'].includes(pokemon.effectiveWeather())) return this.chainModify(2); if (move.type === 'Fire') return this.chainModify(1.5); if (move.type === 'Water') return this.chainModify(0.5); }, onSetStatus(status, target, source, effect) { if (effect && effect.status) this.add('-immune', target, '[from] ability: Mega Sol + Leaf Guard'); return false; }, onTryAddVolatile(status, target) { if (status.id === 'yawn') { this.add('-immune', target, '[from] ability: Mega Sol + Leaf Guard'); return null; } }, flags: {breakable: 1}}"
    }
  ],
